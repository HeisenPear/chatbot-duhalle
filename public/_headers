# En-têtes des fichiers statiques (widget.js, page de démonstration).
# Les réponses de l'API /api/* ont les leurs, posées par le Worker.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Robots-Tag: noindex

# Le widget est chargé par le site Duhallé avec une empreinte d'intégrité
# (attribut integrity) : le navigateur doit pouvoir le lire en mode CORS.
# Chaque version (/v/<version>.js) ne change jamais : cache d'un an.
# Le jeu de caractères est annoncé : sans lui, un navigateur lit le fichier avec l'encodage de la
# page qui l'appelle, et les pages Oxatis ne sont pas en UTF-8.
/v/*
  Content-Type: text/javascript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable

# Ancienne adresse unique, figée, pour les balises qui y pointent encore.
/widget.js
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
